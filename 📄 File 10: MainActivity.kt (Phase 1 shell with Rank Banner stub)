class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState {
        super.onCreate(savedInstanceState)
        setContent {
            DisciplineTheme {
                Surface(Modifier.fillMaxSize(), color = BackgroundCanvas) {
                    DashboardScreen()
                }
            }
        }
    }
}

@Composable
fun DashboardScreen() {
    val scope = rememberCoroutineScope()
    val dao = DisciplineDatabase.get(appContext).dao()
    var totalRp by remember { mutableStateOf(0L) }

    Column(
        Modifier.fillMaxSize().padding(16.dp),
        horizontalAlignment = Alignment.CenterHorizontally
    ) {
        // ── RP Rank Banner (Portrait Top Section) ──
        GlassCard {
            Text("🛡️ DISCIPLINE ENGINE", color = CyberCyan, style = MaterialTheme.typography.titleLarge)
            Spacer(Modifier.height(8.dp))
            Text("Total RP: $totalRp", color = XpRankGold, style = MaterialTheme.typography.headlineMedium)
            Text("Rank: BRONZE", color = VerifiedEmerald)
        }
        Spacer(Modifier.height(16.dp))
        GlassCard {
            Text("✅ Complete P1 Study Block (+40 RP)", color = P1CriticalNeon)
            Spacer(Modifier.height(8.dp))
            Button(onClick = {
                scope.launch {
                    dao.addRpEvent(RpEventEntity(System.currentTimeMillis(), "P1_BLOCK", +40))
                    totalRp = dao.totalRp()
                }
            }) { Text("Claim RP (Test)") }
        }
        Spacer(Modifier.height(16.dp))
        Text("Phase 1 ✅ | Alarm: Phase 3 | Blocker: Phase 6",
            color = VerifiedEmerald, style = MaterialTheme.typography.bodySmall)
    }
}

